# ==============================================
# NezaMateriales — Variables de Entorno
# ==============================================
# Copia este archivo como .env y llena los valores.
# NUNCA subas .env al repositorio.

# ----- MySQL -----
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=3306
DB_NAME=neza_materiales
# Solo en Cloud Run + Cloud SQL: ruta del socket unix montado automáticamente
# (formato /cloudsql/PROYECTO:REGION:INSTANCIA). Si se define, tiene prioridad
# sobre DB_HOST/DB_PORT. Dejar comentado en desarrollo local / MySQL propio.
# INSTANCE_UNIX_SOCKET=/cloudsql/neza-materiales-2026:us-central1:neza-mysql

# ----- Aplicación -----
# IMPORTANTE: en el despliegue real (Cloud Run) debe ser "production".
# Con APP_ENV=production, el webhook de WhatsApp exige WHATSAPP_APP_SECRET
# configurado y rechaza cualquier petición si falta (ver whatsapp.py).
APP_ENV=development
APP_DEBUG=true

# ----- CORS -----
# Lista separada por comas de orígenes permitidos a llamar a la API.
ALLOWED_ORIGINS=https://neza-materiales-2026.web.app,https://neza-materiales-2026.firebaseapp.com

# ----- Bot de WhatsApp (Meta WhatsApp Cloud API) -----
# Token que tú inventas y registras en Meta for Developers al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=tu_verify_token_aqui
# Token de acceso permanente de tu app de Meta (System User token recomendado).
WHATSAPP_ACCESS_TOKEN=tu_access_token_aqui
# ID del número de teléfono de WhatsApp Business (Meta for Developers > WhatsApp > API Setup).
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui
# App Secret de tu app de Meta, para validar la firma X-Hub-Signature-256 del webhook.
WHATSAPP_APP_SECRET=tu_app_secret_aqui
WHATSAPP_API_VERSION=v20.0
